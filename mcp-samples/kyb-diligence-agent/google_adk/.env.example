# Copy this file to .env in the same folder before running the agent.

# Trijya's public MCP endpoint.
TRIJYA_MCP_URL=https://mcp.trijya.in/mcp

# Your Trijya API key. Get one free at https://trijya.in/account — sign in,
# then "API keys". The free tier is 1,000 calls a month and caps every
# response at 10 rows; `total_matches` still reports the true total, which is
# why this agent is built to answer from that field rather than from the rows
# it was handed. No key ships in this file on purpose.
TRIJYA_MCP_API_KEY=

# Gemini via Google AI Studio or Vertex AI — whichever your `google-adk`
# install is already configured for.
TRIJYA_AGENT_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=
