# Copy to .env.

# Free key: https://trijya.in/account -> API keys
TRIJYA_API_KEY=
TRIJYA_API_URL=https://api.trijya.in

# Gemini via AI Studio
GOOGLE_API_KEY=
MODEL=gemini-2.5-flash

# ...or Vertex AI instead: leave GOOGLE_API_KEY empty and set these
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=asia-south1
